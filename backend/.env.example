NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nkisi?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Secret for the admin enquiry endpoints (send as header: x-admin-key). Leave empty to disable them.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Set to true when running behind a proxy (Render, Vercel) so rate limiting sees the real client IP
TRUST_PROXY=true
